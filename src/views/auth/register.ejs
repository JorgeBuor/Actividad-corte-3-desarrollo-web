<h1>Registro de usuario</h1>

<form class="form form--auth" action="/register" method="post" novalidate>
  <div class="form__group">
    <label class="form__label" for="name">Nombre:</label>
    <input
      class="form__input <%= errors.name ? 'form__input--error' : '' %>"
      type="text"
      name="name"
      id="name"
      value="<%= old.name || '' %>"
    />
    <% if (errors.name) { %>
    <small class="form__error"><%= errors.name %></small>
    <% } %>
  </div>

  <div class="form__group">
    <label class="form__label" for="email">Email:</label>
    <input
      class="form__input <%= errors.email ? 'form__input--error' : '' %>"
      type="email"
      name="email"
      id="email"
      value="<%= old.email || '' %>"
    />
    <% if (errors.email) { %>
    <small class="form__error"><%= errors.email %></small>
    <% } %>
  </div>

  <div class="form__group">
    <label class="form__label" for="password">Contraseña:</label>
    <input
      class="form__input <%= errors.password ? 'form__input--error' : '' %>"
      type="password"
      name="password"
      id="password"
    />
    <% if (errors.password) { %>
    <small class="form__error"><%= errors.password %></small>
    <% } else { %>
    <small class="form__hint">Mínimo 8 caracteres, con letras y números</small>
    <% } %>
  </div>

  <div class="form__group">
    <label class="form__label" for="password_confirm">Confirmar contraseña:</label>
    <input
      class="form__input <%= errors.password_confirm ? 'form__input--error' : '' %>"
      type="password"
      name="password_confirm"
      id="password_confirm"
    />
    <% if (errors.password_confirm) { %>
    <small class="form__error"><%= errors.password_confirm %></small>
    <% } %>
  </div>

  <button class="button button--primary" type="submit">Registrarse</button>
  <p>¿Ya tiene cuenta? <a href="/login">Inicie sesión</a></p>
</form>
