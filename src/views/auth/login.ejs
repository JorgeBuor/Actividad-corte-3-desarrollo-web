<h1>Iniciar sesión</h1>

<form class="form form--auth" action="/login" method="post" novalidate>
  <% if (errors.general) { %>
  <div class="alert alert--error"><%= errors.general %></div>
  <% } %>

  <div class="form__group">
    <label class="form__label" for="email">Email:</label>
    <input
      class="form__input <%= errors.email ? 'form__input--error' : '' %>"
      type="email"
      name="email"
      id="email"
      value="<%= old.email || '' %>"
    />
    <% if (errors.email) { %>
    <small class="form__error"><%= errors.email %></small>
    <% } %>
  </div>

  <div class="form__group">
    <label class="form__label" for="password">Contraseña:</label>
    <input
      class="form__input <%= errors.password ? 'form__input--error' : '' %>"
      type="password"
      name="password"
      id="password"
    />
    <% if (errors.password) { %>
    <small class="form__error"><%= errors.password %></small>
    <% } %>
  </div>

  <button class="button button--primary" type="submit">Ingresar</button>
  <p>¿No tiene cuenta? <a href="/register">Regístrese</a></p>
</form>
