<header>
  <nav class="nav">
    <a href="/">CRUD con Node.js</a>
    <ul class="menu">
      <li class="menu__item"><a href="/">Inicio</a></li>
      <li class="menu__item"><a href="/productos">Productos</a></li>
      <li class="menu__item"><a href="/categorias">Categorías</a></li>
      <% if (user) { %>
      <li class="menu__item menu__user">Hola, <%= user.name %></li>
      <li class="menu__item">
        <form action="/logout" method="post">
          <button class="button button--link" type="submit">Cerrar sesión</button>
        </form>
      </li>
      <% } else { %>
      <li class="menu__item"><a href="/login">Ingresar</a></li>
      <li class="menu__item"><a href="/register">Registrarse</a></li>
      <% } %>
    </ul>
  </nav>
</header>
